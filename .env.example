DB_PASSWORD=change-this-password
JWT_SECRET=change-this-secret-in-production
VITE_API_URL=http://localhost:3001

# Password-reset email (Resend). Leave RESEND_API_KEY blank to log the reset
# link to the api container's stdout instead of sending a real email.
RESEND_API_KEY=
MAIL_FROM=Belong <noreply@belong.cyberworksgy.com>
# Origin of the web app, used to build the reset link in the email.
APP_URL=https://belong.cyberworksgy.com

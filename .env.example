DB_PASSWORD=change-this-password
JWT_SECRET=change-this-secret-in-production

# Where the browser reaches the API.
#   Local dev (no Docker): http://localhost:3001
#   Docker (any host):     /api   -- the web container's nginx proxies /api -> api:3001,
#                                    so the app is one origin (works over a bare IP and
#                                    behind a domain/HTTPS alike).
VITE_API_URL=/api

# Public origin of the web app — used to build password-reset links.
APP_URL=https://belongcms.org

# Password-reset email (Resend). Leave RESEND_API_KEY blank to log the reset link
# to the api container's stdout instead of sending. MAIL_FROM must be on a
# Resend-verified domain (or use onboarding@resend.dev for testing to your own
# account address only).
RESEND_API_KEY=
MAIL_FROM=Belong <noreply@belongcms.org>

# --- Only for the Traefik production overlay (docker-compose.prod.yml) ---
# Setting COMPOSE_FILE makes every bare `docker compose` command use the overlay,
# so you don't have to pass -f each time (and can't forget it and take the site down).
# Do NOT also create a docker-compose.override.yml on this box — if COMPOSE_FILE
# is ever not picked up, the override silently wins and Traefik gets no labels.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# APP_DOMAIN=belongcms.org
#
# TRAEFIK_NETWORK is REQUIRED: the external docker network your Traefik runs on
# (run `docker network ls` — often proxy / traefik / web / edge). The overlay
# attaches the web container to this network so Traefik can actually reach it.
# TRAEFIK_NETWORK=proxy
# TRAEFIK_CERTRESOLVER=letsencrypt
# TRAEFIK_ENTRYPOINT=websecure

DB_PASSWORD=change-this-password
JWT_SECRET=change-this-secret-in-production
# Where the browser reaches the API.
#   Local dev:            http://localhost:3001
#   Docker (any host):    /api   -- the web container's nginx proxies /api -> api:3001,
#                                    so the app is one origin on port 8080 (works over
#                                    a bare IP and behind a domain/HTTPS alike).
VITE_API_URL=/api

# Password-reset email (Resend). Leave RESEND_API_KEY blank to log the reset
# link to the api container's stdout instead of sending a real email.
RESEND_API_KEY=
MAIL_FROM=Belong <noreply@belong.cyberworksgy.com>
# Origin of the web app, used to build the reset link in the email.
APP_URL=https://belong.cyberworksgy.com

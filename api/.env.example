DATABASE_URL=postgres://postgres:postgres@localhost:5432/church_membership
# Required: random, at least 32 characters (e.g. `openssl rand -hex 32`). The API
# refuses to start without it, or with the old placeholder value.
JWT_SECRET=
PORT=3001
# Only for local dev with the Vite dev server on another port. Leave unset in
# Docker/production, where nginx makes the app single-origin (no CORS needed).
CORS_ORIGINS=http://localhost:5173

# Password-reset email (Resend). Leave RESEND_API_KEY blank to log the reset
# link to the console instead of sending a real email.
RESEND_API_KEY=
MAIL_FROM=Belong <noreply@belong.cyberworksgy.com>
# Origin of the web app, used to build the reset link.
APP_URL=http://localhost:5173

# Notify an operator inbox whenever a new church signs up for a trial (separate
# from the welcome email the new admin gets). Leave blank to skip.
SIGNUP_ALERT_EMAIL=

# Notify an operator inbox whenever an org submits an MMG payment reference and
# moves to pending_review, with a link to verify/activate it in /admin. Leave
# blank to skip.
PAYMENT_ALERT_EMAIL=
